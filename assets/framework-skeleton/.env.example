# Copy to qa/.env and fill in. Never commit the real .env — it holds test credentials.
# Precedence: CLI flags > environment variables > this file > config/environments.py defaults.
QA_ENV=local
QA_BASE_URL=http://127.0.0.1:5000
QA_API_BASE_URL=http://127.0.0.1:5000
QA_API_HEALTH_PATH=/api/health
QA_BROWSER=chrome
QA_HEADLESS=true
QA_TIMEOUT=10
QA_PAGE_LOAD_TIMEOUT=30
QA_TEST_TIMEOUT=300          # per-test watchdog seconds (0 disables)
QA_WINDOW_SIZE=1440x900
QA_REPORTS_DIR=reports
QA_TESTID_ATTRIBUTE=data-testid

# Test accounts (disposable, non-production). The values below are the demo app's accounts.
QA_TEST_USER_EMAIL=qa.user@example.test
QA_TEST_USER_PASSWORD=Password123!
QA_ADMIN_EMAIL=qa.admin@example.test
QA_ADMIN_PASSWORD=Password123!

# Run metadata
# QA_BUILD_ID=                # explicit build/version id; git SHA/branch of QA_APP_REPO is recorded automatically
# QA_APP_REPO=..              # repository whose git state identifies the build (default: parent of qa/)

# Optional execution modes
# QA_REMOTE_URL=http://localhost:4444/wd/hub     # Selenium Grid / BrowserStack / Sauce
# QA_MOBILE_DEVICE=iPhone 12 Pro                 # Chrome mobile emulation
# QA_A11Y=false                                  # axe-core observations after each browser test
# QA_TRACE=false                                 # screenshot after every page action
# QA_FRESH_SESSION=false                         # disable ctx.login_once() reuse
# QA_AXE_PATH=                                   # local axe.min.js for offline --a11y

# Optional: explicit binaries for offline CI where Selenium Manager cannot download drivers
# QA_CHROME_BINARY=
# QA_CHROMEDRIVER_PATH=
# QA_FIREFOX_BINARY=
# QA_GECKODRIVER_PATH=
# QA_CHROME_NO_SANDBOX=true   # only inside containers that run as root
